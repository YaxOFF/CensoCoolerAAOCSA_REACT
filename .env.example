# Copia este archivo a .env y ajusta los valores.
# Las variables EXPO_PUBLIC_* quedan embebidas en el bundle: no pongas secretos aquí.
# Tras cualquier cambio hay que reiniciar el bundler con caché limpia: npx expo start -c

# true  => datos simulados en el dispositivo (src/api/mock.ts). Es el default.
# false => llamadas HTTP reales (src/api/http.ts).
EXPO_PUBLIC_USE_MOCK=true

# URL base del backend, sin diagonal final. Solo se usa cuando USE_MOCK=false.
# En Android físico usa la IP de tu máquina, no localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000/api

# Token JWT que se manda como Authorization: Bearer. Queda embebido en el bundle.
EXPO_PUBLIC_API_TOKEN=
