# Copia este archivo a .env y ajusta los valores.
# Las variables EXPO_PUBLIC_* quedan embebidas en el bundle: no pongas secretos aquí.
# Tras cualquier cambio hay que reiniciar el bundler con caché limpia: npx expo start -c

# true  => datos simulados en el dispositivo (src/api/mock.ts). Es el default.
# false => llamadas HTTP reales (src/api/http.ts).
EXPO_PUBLIC_USE_MOCK=true

# URL base del backend, sin diagonal final e INCLUYENDO /api: las rutas se arman a
# partir de aquí (/frog/enfriadores/:serie, /coolers, /coolers/:id/evidencias).
# En Android físico usa la IP de tu máquina, no localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8091/api

# Token JWT que se manda como Authorization: Bearer. Todos los endpoints lo exigen.
# Queda embebido en el bundle.
EXPO_PUBLIC_API_TOKEN=

# Solo si el backend emite las URLs de las fotos con un host que el teléfono no
# alcanza (típicamente localhost). Se reescribe el host de cada evidencia.
# Vacío = se usan tal cual (correcto en producción y con `adb reverse`).
EXPO_PUBLIC_IMG_URL=

# Servidor de distribución del APK (auto-actualización). Ahí viven version.json y
# el .apk. Sin diagonal final. Vacío = se usa el default de src/api/updates.ts.
EXPO_PUBLIC_UPDATE_URL=https://files.censo.aaocsa.com/app-release
